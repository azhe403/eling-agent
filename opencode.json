{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "eling_dev": {
      "enabled": true,
      "type": "local",
      "command": [
        "dotnet",
        "watch",
        "--project",
        "src/backend/Eling.Host/Eling.Host.csproj"
      ],
      "environment": {
        "ELING_DASHBOARD_PORT": "4417",
        "ELING_WATCH_DASHBOARD": "1"
      }
    },
    "shadcn": {
      "type": "local",
      "command": [
        "npx",
        "shadcn@latest",
        "mcp"
      ],
      "enabled": true
    },
    "next-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@vercel/next-devtools-mcp"
      ],
      "enabled": true
    }
  }
}
