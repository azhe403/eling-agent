<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Eling.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="440"
             x:Class="Eling.Desktop.Views.HostBrowseView"
             x:DataType="vm:HostBrowseViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="16">
        <!-- Hint -->
        <TextBlock Grid.Row="0" Text="Double-click or press → to enter a folder, then Use This Folder." FontSize="11" Foreground="#9ca3af" Margin="0,0,0,6" />
        <!-- Path bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button Content="↑ Up" Command="{Binding UpCommand}" Padding="8,4" FontSize="12"/>
            <TextBox Text="{Binding CurrentPath}" MinWidth="360" PlaceholderText="Backend path"
                     FontSize="12" Padding="6,4"/>
            <Button Content="Go" Command="{Binding GoCommand}" Padding="8,4" FontSize="12"/>
        </StackPanel>

        <!-- Drives / files list -->
        <ListBox Grid.Row="2" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                 DoubleTapped="OnEntryDoubleTapped"
                 Background="Transparent" BorderThickness="0">
            <ListBox.Styles>
                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="#2e2e2e"/>
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                    <Setter Property="Background" Value="#3a3a3a"/>
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
                <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="#424242"/>
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8,6" CornerRadius="6" Background="Transparent">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="📁" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" IsVisible="{Binding IsDirectory}"/>
                            <TextBlock Grid.Column="0" Text="📄" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" IsVisible="{Binding !IsDirectory}"/>
                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="12" Foreground="#e5e7eb"
                                       Padding="0,3" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="→" FontSize="11" Padding="6,2" Margin="8,0,0,0" Classes="subtle"
                                    Command="{Binding $parent[UserControl].((vm:HostBrowseViewModel)DataContext).OpenEntryCommand}"
                                    CommandParameter="{Binding}" ToolTip.Tip="Enter this folder" IsVisible="{Binding IsDirectory}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Status -->
        <TextBlock Grid.Row="3" Text="{Binding StatusText}" FontSize="11" Foreground="#6b7280"
                   Margin="0,6,0,0" TextTrimming="CharacterEllipsis" IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

        <!-- Selection preview (only once a folder is picked or entered) -->
        <Border Grid.Row="4" Background="#14263b" BorderBrush="#1e3a5f" BorderThickness="1" CornerRadius="6"
                Padding="10,8" Margin="0,8,0,0"
                IsVisible="{Binding UseThisPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" Text="Will use:" FontSize="11" Foreground="#60a5fa" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" Text="{Binding UseThisPath}" FontSize="12" FontWeight="SemiBold" Foreground="#e5e7eb"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <!-- Action buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="8" Margin="0,10,0,0">
            <Button Content="Cancel" Click="OnCancel" Classes="subtle" Padding="10,6" FontSize="12"/>
            <Button Content="Use This Folder" Click="OnUseFolder" Classes="primary" Padding="10,6" FontSize="12"/>
        </StackPanel>
    </Grid>

</UserControl>
