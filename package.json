{
  "name": "eling-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"cross-env ELING_DASHBOARD_PORT=4417 dotnet run --project src/backend/Eling.Backend/Eling.Backend.csproj\" \"pnpm --prefix src/frontend/Eling.Dashboard dev\"",
    "dev:backend": "cross-env ELING_DASHBOARD_PORT=4417 dotnet run --project src/backend/Eling.Backend/Eling.Backend.csproj",
    "dev:frontend": "pnpm --prefix src/frontend/Eling.Dashboard dev",
    "prepare": "husky",
    "lint:frontend": "pnpm --prefix src/frontend/Eling.Dashboard lint",
    "typecheck:frontend": "pnpm --prefix src/frontend/Eling.Dashboard exec tsc --noEmit",
    "validate:backend": "cross-env ELING_OUTPUT_ROOT=.bin-test dotnet restore Eling.slnx",
    "build:backend": "cross-env ELING_OUTPUT_ROOT=.bin-test dotnet build Eling.slnx",
    "test:backend": "pwsh -NoProfile -File scripts/test-backend.ps1 -Layer all",
    "test:backend:full": "pwsh -NoProfile -File scripts/test-backend.ps1 -Layer full",
    "test:backend:core": "pwsh -NoProfile -File scripts/test-backend.ps1 -Layer core",
    "test:backend:api": "pwsh -NoProfile -File scripts/test-backend.ps1 -Layer api",
    "test:backend:desktop": "pwsh -NoProfile -File scripts/test-backend.ps1 -Layer desktop",
    "clean:bin": "pwsh -NoProfile -File scripts/clean-bin.ps1",
    "build:frontend": "pnpm --prefix src/frontend/Eling.Dashboard build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "husky": "^9.1.7",
    "shadcn": "^4.22.1"
  }
}
