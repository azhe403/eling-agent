<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Eling.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="870" d:DesignHeight="700"
             x:Class="Eling.Desktop.Views.ChatView"
             x:DataType="vm:ChatViewModel"
             Loaded="OnLoaded" Unloaded="OnUnloaded">

    <Grid ColumnDefinitions="240,*" Margin="0">
        <!-- Sidebar: Chat History & Workspaces -->
        <Border Grid.Column="0" Background="#141416" BorderBrush="#252528" BorderThickness="1" CornerRadius="6" Margin="0,0,6,0" Padding="8">
            <Grid RowDefinitions="Auto,*,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="4,4,4,8">
                    <TextBlock Text="Chats &amp; Folders" FontSize="12" FontWeight="SemiBold" Foreground="#e5e7eb" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="+" Command="{Binding NewChatCommand}" Classes="subtle" Padding="6,2" FontSize="12" ToolTip.Tip="New Chat"/>
                </Grid>

                <ListBox Grid.Row="1" ItemsSource="{Binding SidebarItems}" SelectedItem="{Binding SelectedRow}" Background="Transparent" BorderThickness="0" Padding="0">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="#27272a"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected TextBlock">
                            <Setter Property="Foreground" Value="#ffffff"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SidebarRow">
                            <Border CornerRadius="4" Padding="8,5" Margin="0,1">
                                <TextBlock Text="{Binding ItemDisplay}"
                                           FontSize="{Binding FontSize}"
                                           FontWeight="{Binding FontWeight}"
                                           Foreground="{Binding TextColor}"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ComboBox Grid.Row="2" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}"
                          HorizontalAlignment="Stretch" Margin="2,8,2,2" PlaceholderText="Select model" FontSize="11"/>
            </Grid>
        </Border>

        <!-- Main Chat Area -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,Auto">
            <Border Grid.Row="0" Background="#161616" BorderBrush="#2a2a2a" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="📁" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding FolderDisplayName}" FontSize="13" FontWeight="SemiBold" Foreground="#e5e7eb" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ActiveWorkspace, StringFormat='({0})'}" FontSize="11" Foreground="#6b7280" VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="350"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <ToggleSwitch x:Name="AutoScrollToggle" OnContent="Auto-scroll" OffContent="Auto-scroll" IsChecked="True" FontSize="11"/>
                        <Button Content="+ New Chat" Command="{Binding NewChatCommand}" Classes="subtle" Padding="8,4" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" x:Name="MessagesScrollViewer"
                          Margin="0,4"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="MessagesItemsControl"
                              ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatMessageRow">
                            <Border Classes="memory-card" Margin="0,3,0,6">
                                <Grid RowDefinitions="Auto,Auto,Auto">
                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                            <Border Background="{Binding HeaderColor}" CornerRadius="4" Padding="8,2">
                                                <TextBlock Text="{Binding HeaderDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                            </Border>
                                            <TextBlock Text="{Binding Arguments, StringFormat='args: {0}'}"
                                                       IsVisible="{Binding HasArguments}"
                                                       FontSize="11" Foreground="#9ca3af" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="450"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="{Binding ExpandButtonText}"
                                                Command="{Binding ToggleExpand}"
                                                IsVisible="{Binding IsTool}"
                                                Classes="subtle"
                                                FontSize="10"
                                                Padding="6,2"/>
                                    </Grid>
                                <Border Grid.Row="1" Height="1" Background="#2a2a2a" Margin="0,8,0,8"
                                        IsVisible="{Binding IsExpanded}"/>

                                <!-- Message content body: parsed markdown blocks -->
                                <ItemsControl Grid.Row="2"
                                              ItemsSource="{Binding Blocks}"
                                              IsVisible="{Binding IsExpanded}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MessageBlock">
                                            <Panel Margin="0,2,0,4">
                                                <!-- Plain Text Block -->
                                                <SelectableTextBlock Text="{Binding Content}"
                                                                     IsVisible="{Binding IsText}"
                                                                     FontSize="13.5"
                                                                     FontFamily="Inter,Segoe UI,sans-serif"
                                                                     Foreground="#f8fafc"
                                                                     TextWrapping="Wrap"/>

                                                <!-- Code Block Container -->
                                                <Border IsVisible="{Binding IsCode}"
                                                        Background="#0f0f11"
                                                        BorderBrush="#2d2d32"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="10,8"
                                                        Margin="0,4,0,4">
                                                    <Grid RowDefinitions="Auto,*">
                                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding LanguageDisplay}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#94a3b8"
                                                                       VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1"
                                                                    Content="📋 Copy"
                                                                    Command="{Binding CopyToClipboard}"
                                                                    Classes="subtle"
                                                                    FontSize="10"
                                                                    Padding="6,2"/>
                                                        </Grid>
                                                        <Border Grid.Row="0" Height="1" Background="#27272a" Margin="0,22,0,0"/>
                                                        <SelectableTextBlock Grid.Row="1"
                                                                             Text="{Binding Content}"
                                                                             FontSize="12"
                                                                             FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                                                                             Foreground="#e2e8f0"
                                                                             TextWrapping="Wrap"/>
                                                    </Grid>
                                                </Border>
                                            </Panel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <TextBox Grid.Column="0" x:Name="InputBox" Text="{Binding Input}" PlaceholderText="Ask about the project... (Enter to send, Shift+Enter for new line)"
                         AcceptsReturn="True" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Content="Send" Command="{Binding SendCommand}"
                        Classes="primary" Margin="8,0,0,0" IsEnabled="{Binding !IsBusy}"/>
            </Grid>

            <TextBlock Grid.Row="3" Text="{Binding StatusText}" FontSize="11" Foreground="#6b7280" Margin="0,4,0,0"
                       IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </Grid>
    </Grid>

</UserControl>
