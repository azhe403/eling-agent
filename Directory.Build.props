<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- One centralized output for every invocation (build/test/run/publish),
         so the paired eling/eling-dashboard binaries always coexist in
         .artifacts/bin/<Project>/<config>. -->
    <ArtifactsPath>$(MSBuildThisFileDirectory).artifacts</ArtifactsPath>
    <!-- eling-live MCP launches via `dotnet run`: any MSBuild output would pollute
         the stdout JSON-RPC stream. Keep restore/build output silent repo-wide. -->
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
</Project>
