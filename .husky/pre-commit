#!/bin/sh
# Scope-aware pre-commit: test the layer touched plus every layer it depends
# on, mirroring the C# dependency chain (desktop -> backend -> core):
# - core change      -> test:backend:core
# - backend change   -> test:backend:core + test:backend:api
# - desktop change   -> test:backend:core + test:backend:api + test:backend:desktop
# - dashboard change -> frontend lint + typecheck only (no C# impact)
# - build/config     -> core + api + desktop (package.json also frontend)
# - docs only        -> nothing, instant
# Bypass: SKIP_HOOK=1 git commit --no-verify  or  FULL_CHECK=1 git commit

if [ "$SKIP_HOOK" = "1" ]; then
  echo "→ SKIP_HOOK=1: skipping pre-commit"
  exit 0
fi

# Anti-lock: every dotnet invocation below builds/tests under a disposable
# per-run root (.bin-hook-<pid>), so it can never collide with the dev
# server (.bin), manual runs (.bin-test), MCP hosts, or another hook
# running concurrently. NOTE: plain `export ELING_OUTPUT_ROOT` does not
# work here — package.json scripts hardcode it via cross-env — so the
# dotnet calls below set it inline (same precedent as scripts/ci-check.sh).
# Already gitignored (.bin*) and auto-cleaned by scripts/clean-bin.ps1.
HOOK_ROOT=".bin-hook-$$"
trap 'rm -rf "$HOOK_ROOT"' EXIT INT TERM

# Core tests are fast (~2s) and their observed failure mode is intermittent
# (parallel-class races, or a mid-edit compile window while another session
# writes the tree), not deterministic breakage. Retry before failing so one
# flake cannot block the commit; a real failure still fails all attempts.
# Runs under $HOOK_ROOT (see above) so retries never meet a locked output.
# Defined before FULL_CHECK because that block calls it.
run_core_tests() {
  attempt=1
  while [ "$attempt" -le 3 ]; do
    echo "→ core tests (attempt $attempt/3)"
    if ELING_OUTPUT_ROOT="$HOOK_ROOT" dotnet test tests/Eling.Core.Tests/Eling.Core.Tests.csproj; then
      return 0
    fi
    attempt=$((attempt + 1))
    if [ "$attempt" -le 3 ]; then sleep 3; fi
  done
  return 1
}

CHANGED=$(git diff --cached --name-only 2>/dev/null)

if [ "$FULL_CHECK" = "1" ]; then
  echo "→ FULL_CHECK=1: running all checks (isolated output $HOOK_ROOT)"
  pnpm lint:frontend || exit 1
  pnpm typecheck:frontend || exit 1
  pnpm validate:backend || exit 1
  run_core_tests || exit 1
  echo "→ api layer: test:backend:api"
  ELING_OUTPUT_ROOT="$HOOK_ROOT" dotnet test tests/Eling.Backend.Tests/Eling.Backend.Tests.csproj --filter FullyQualifiedName!~DashboardLifecycleTests || exit 1
  echo "→ desktop layer: test:backend:desktop"
  ELING_OUTPUT_ROOT="$HOOK_ROOT" dotnet test tests/Eling.Desktop.Tests/Eling.Desktop.Tests.csproj || exit 1
  exit 0
fi

# Enforce one-layer-per-commit: dashboard, backend, desktop must not mix.
# Shared/build files are excluded from the count so they may join any layer.
if [ "$ALLOW_MIXED" != "1" ]; then
  SCOPE_FILES=$(echo "$CHANGED" | grep -vE "^(Directory\.Build|Eling\.slnx|mise\.toml|package\.json|pnpm-lock\.yaml|CHANGELOG\.md|README\.md|INSTALL\.md|NUGET-WEEKLY-CHECK\.md|docs/|\.husky/|\.github/)" || true)
  TOUCH_DASHBOARD=0
  TOUCH_BACKEND=0
  TOUCH_DESKTOP=0
  if echo "$SCOPE_FILES" | grep -qE "^(src/frontend/|tests/.*Frontend|tests/.*Dashboard)"; then
    TOUCH_DASHBOARD=1
  fi
  if echo "$SCOPE_FILES" | grep -qE "^(src/backend/|tests/Eling\.Core|tests/Eling\.Backend)"; then
    TOUCH_BACKEND=1
  fi
  if echo "$SCOPE_FILES" | grep -qE "^(src/desktop/|tests/Eling\.Desktop)"; then
    TOUCH_DESKTOP=1
  fi
  TOUCH_COUNT=$((TOUCH_DASHBOARD + TOUCH_BACKEND + TOUCH_DESKTOP))
  if [ "$TOUCH_COUNT" -gt 1 ]; then
    echo "⛔ This commit mixes $TOUCH_COUNT layers (dashboard / backend / desktop)."
    echo "Please split it into one commit per layer."
    echo "Example: one commit for dashboard, one for backend, one for desktop."
    echo "If it is truly shared config, use a separate 'chore: shared config' commit."
    echo "To bypass once (emergency only): ALLOW_MIXED=1 git commit"
    exit 1
  fi
fi

NEED_FRONTEND=0
NEED_CORE=0
NEED_API=0
NEED_DESKTOP=0

if echo "$CHANGED" | grep -q "^src/frontend/"; then
  NEED_FRONTEND=1
fi

# Core layer: core tests only.
if echo "$CHANGED" | grep -qE "^(src/backend/Eling\.Core/|tests/Eling\.Core\.Tests/)"; then
  NEED_CORE=1
fi

# Backend layer: pulls core in (backend depends on core).
if echo "$CHANGED" | grep -qE "^(src/backend/Eling\.Backend/|tests/Eling\.Backend\.Tests/)"; then
  NEED_CORE=1
  NEED_API=1
fi

# Desktop layer: pulls backend + core in (desktop depends on both).
if echo "$CHANGED" | grep -qE "^(src/desktop/|tests/Eling\.Desktop\.Tests/)"; then
  NEED_CORE=1
  NEED_API=1
  NEED_DESKTOP=1
fi

# Any other backend project (future one, not Eling.Core): assume api layer.
if echo "$CHANGED" | grep -qE "^src/backend/" && [ "$NEED_CORE" = "0" ]; then
  NEED_CORE=1
  NEED_API=1
fi

# Unknown tests/ change (e.g. a new test project): run all C# layers.
if echo "$CHANGED" | grep -qE "^tests/" && [ "$NEED_CORE" = "0" ] && [ "$NEED_API" = "0" ] && [ "$NEED_DESKTOP" = "0" ]; then
  NEED_CORE=1
  NEED_API=1
  NEED_DESKTOP=1
fi

# Solution/build files affect every C# layer.
if echo "$CHANGED" | grep -qE "^(Directory\.Build|Eling\.slnx|mise\.toml)"; then
  NEED_CORE=1
  NEED_API=1
  NEED_DESKTOP=1
fi

# package manifest affects both worlds.
if echo "$CHANGED" | grep -qE "^(package\.json|pnpm-lock\.yaml)"; then
  NEED_FRONTEND=1
  NEED_CORE=1
  NEED_API=1
  NEED_DESKTOP=1
fi

if [ "$NEED_FRONTEND" = "0" ] && [ "$NEED_CORE" = "0" ] && [ "$NEED_API" = "0" ] && [ "$NEED_DESKTOP" = "0" ]; then
  echo "→ pre-commit: docs/config only, nothing to test"
  exit 0
fi

if [ "$NEED_FRONTEND" = "1" ]; then
  echo "→ frontend changed: lint + typecheck (parallel)"
  pnpm lint:frontend & LINT_PID=$!
  pnpm typecheck:frontend & TYPE_PID=$!
  wait $LINT_PID || exit 1
  wait $TYPE_PID || exit 1
else
  echo "→ skip frontend (no src/frontend/)"
fi

if [ "$NEED_CORE" = "1" ]; then
  run_core_tests || exit 1
fi

if [ "$NEED_API" = "1" ]; then
  echo "→ api layer: test:backend:api (isolated output $HOOK_ROOT)"
  ELING_OUTPUT_ROOT="$HOOK_ROOT" dotnet test tests/Eling.Backend.Tests/Eling.Backend.Tests.csproj --filter FullyQualifiedName!~DashboardLifecycleTests || exit 1
fi

if [ "$NEED_DESKTOP" = "1" ]; then
  echo "→ desktop layer: test:backend:desktop (isolated output $HOOK_ROOT)"
  ELING_OUTPUT_ROOT="$HOOK_ROOT" dotnet test tests/Eling.Desktop.Tests/Eling.Desktop.Tests.csproj || exit 1
fi
