# Build outputs
bin/
obj/
.artifacts/
.bin*
.mybin/
.vs/
.idea/
.tmp
*.user

# Node / Next.js
node_modules/
.next/
out/
build/
*.log

# Databases / Caches
# *.db matches the database itself; *.db-* matches every SQLite sidecar
# (-journal, -wal, -shm, -wal2). Prefer this over naming each suffix: sidecars
# are always "<name>.db-<suffix>", so the pattern stays complete as SQLite adds
# more, and it does not over-match unrelated names like *.dbf or *.dbg.
*.db
*.db-*

# Eling (generated runtime files; .eling/memories/ is tracked in git)
# Databases are already covered by the *.db / *.db-* rules above, so only the
# runtime directory is named here.
.eling/index.db*
.eling/runtime/

# Superpowers scratch directory
.superpowers/

# Test run outputs
TestResults/

.vercel
.env*

# Turborepo
.turbo

# Agents
.omo

# Agent scratch (opencode, openchamber, plan files)
.opencode/scratch/
.openchamber/
*.backup
opencode.json.openchamber.backup

# Lint / typecheck output artifacts (not source)
*.err.txt
*.out.txt

*.zip
