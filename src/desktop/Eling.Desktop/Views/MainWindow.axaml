<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Eling.Desktop.ViewModels"
        xmlns:m="using:Eling.Desktop.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:Eling.Desktop"
        xmlns:conv="using:Eling.Desktop.Converters"
        xmlns:views="using:Eling.Desktop.Views"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="Eling.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/eling.ico"
        Title="Eling"
        Width="1050" Height="720">

    <Grid>
        <!-- Main Application Layout -->
        <Grid ColumnDefinitions="*,96" RowDefinitions="Auto,*,Auto">

            <!-- Top Bar -->
            <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#1a1a1a" Padding="16,12" BorderBrush="#2a2a2a" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="🧠 Eling" FontSize="20" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <Border Background="#242424" BorderBrush="#333333" BorderThickness="1"
                                CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                    <Ellipse.Fill>
                                        <SolidColorBrush Color="{Binding SseStatus, Converter={x:Static conv:SseStatusColorConverter.Instance}}"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock Text="{Binding SseStatus}" FontSize="11" Foreground="#9ca3af"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Grid.Column="0" Margin="6">
                <Grid>
                    <views:ChatView x:Name="ChatPanel" DataContext="{x:Null}" />
                    <views:FoldersView x:Name="WorkspacesPanel" IsVisible="False" DataContext="{x:Null}" />
                    <Grid x:Name="MemoryPanel" IsVisible="False">
                        <Grid.ColumnDefinitions>280,*</Grid.ColumnDefinitions>
                        <!-- Workspace picker: the dashboard's scope panel, cloned -->
                        <Border Grid.Column="0" Background="#161616" BorderBrush="#2a2a2a" BorderThickness="0,0,1,0" Padding="10,12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="6" Margin="0,0,4,0">
                                    <!-- All workspaces -->
                                    <Button Command="{Binding SelectAllCommand}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Padding="8,6"
                                            Background="{Binding AllWorkspacesBackground}"
                                            BorderBrush="#2f2f2f"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            ToolTip.Tip="Include every workspace in the selection">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="🗂" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Text="All workspaces" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="#e5e7eb" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Grouping: flat / repo / folder -->
                                    <Border Background="Transparent" BorderBrush="#2f2f2f" BorderThickness="1"
                                            CornerRadius="8" Padding="2">
                                        <Grid ColumnDefinitions="*,*,*">
                                            <Button Grid.Column="0" Content="Flat" FontSize="11" Padding="8,4"
                                                    Command="{Binding SetWorkspaceGroupModeCommand}" CommandParameter="0"
                                                    Background="{Binding WorkspaceGroupMode, Converter={x:Static conv:SegmentButtonConverter.Instance}, ConverterParameter=0}"
                                                    BorderThickness="0" CornerRadius="6"
                                                    ToolTip.Tip="One row per workspace, the way the runtime registry holds them"/>
                                            <Button Grid.Column="1" Content="Repo" FontSize="11" Padding="8,4"
                                                    Command="{Binding SetWorkspaceGroupModeCommand}" CommandParameter="1"
                                                    Background="{Binding WorkspaceGroupMode, Converter={x:Static conv:SegmentButtonConverter.Instance}, ConverterParameter=1}"
                                                    BorderThickness="0" CornerRadius="6"
                                                    ToolTip.Tip="One entry per git repository, with its worktrees nested under it"/>
                                            <Button Grid.Column="2" Content="Folder" FontSize="11" Padding="8,4"
                                                    Command="{Binding SetWorkspaceGroupModeCommand}" CommandParameter="2"
                                                    Background="{Binding WorkspaceGroupMode, Converter={x:Static conv:SegmentButtonConverter.Instance}, ConverterParameter=2}"
                                                    BorderThickness="0" CornerRadius="6"
                                                    ToolTip.Tip="One entry per workspace, nested by the folders that hold them"/>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="No indexed workspaces." FontSize="11" Foreground="#6b7280"
                                               Margin="4,6" IsVisible="{Binding HasNoWorkspaces}"/>

                                    <!-- Rows: chevron, checkbox, icon, label, group count, liveness -->
                                    <ItemsControl ItemsSource="{Binding VisibleWorkspaces}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="m:MemoryWorkspaceNode">
                                                <Border Classes="workspace-row" CornerRadius="6" Margin="{Binding RowMargin}"
                                                        Padding="0,1" Background="Transparent">
                                                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                                                        <Button Grid.Column="0" Content="{Binding ChevronGlyph}"
                                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleWorkspaceExpansionCommand}"
                                                                CommandParameter="{Binding}"
                                                                Classes="subtle" Padding="0" Width="14" FontSize="9"
                                                                Foreground="#9ca3af"
                                                                IsVisible="{Binding HasChildren}"
                                                                ToolTip.Tip="Expand or collapse"/>
                                                        <CheckBox Grid.Column="1"
                                                                  IsChecked="{Binding CheckState, Mode=OneWay}"
                                                                  IsThreeState="False"
                                                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleWorkspaceGroupCommand}"
                                                                  CommandParameter="{Binding}"
                                                                  Padding="0" VerticalAlignment="Center"
                                                                  Cursor="Hand"
                                                                  ToolTip.Tip="Include this workspace in the selection"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding IsWorktree, Converter={x:Static conv:WorktreeIconConverter.Instance}}"
                                                                   FontSize="12" Foreground="#9ca3af" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                        <Button Grid.Column="3" Classes="workspace-label"
                                                                ToolTip.Tip="{Binding Path}"
                                                                IsVisible="{Binding CanSelectOnly}"
                                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectOnlyWorkspaceCommand}"
                                                                CommandParameter="{Binding Row}">
                                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                                                       TextWrapping="NoWrap" VerticalAlignment="Center"/>
                                                        </Button>
                                                        <TextBlock Grid.Column="3" Text="{Binding Label}"
                                                                   FontSize="12" Foreground="#e5e7eb"
                                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                                                   IsVisible="{Binding !CanSelectOnly}"/>
                                                        <Border Grid.Column="4" Background="#262626" CornerRadius="3"
                                                                Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                IsVisible="{Binding ShowGroupCount}">
                                                            <TextBlock Text="{Binding GroupCountText}" FontSize="9"
                                                                       Foreground="#9ca3af"/>
                                                        </Border>
                                                        <Ellipse Grid.Column="5" Width="6" Height="6" Margin="8,0,4,0"
                                                                 VerticalAlignment="Center"
                                                                 Fill="{Binding DotColor}"
                                                                 ToolTip.Tip="{Binding StatusTip}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <!-- Content -->
                        <Grid Grid.Column="1" Margin="10,0,0,0">
                            <Grid.RowDefinitions>Auto,Auto,Auto,Auto,*</Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                            <Button Command="{Binding CreateMemoryCommand}" Content="+ New Memory"
                                    Classes="primary" Padding="12,6"/>
                            <Button Command="{Binding RefreshCommand}" Content="↻ Refresh"
                                    IsEnabled="{Binding !IsLoading}"/>
                            <Border Background="#242424" BorderBrush="#333333" BorderThickness="1"
                                    CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="{Binding SseStatus, Converter={x:Static conv:SseStatusColorConverter.Instance}}"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Text="{Binding SseStatus}" FontSize="11" Foreground="#9ca3af"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding MemoryCountStatus}" FontSize="11" Foreground="#9ca3af"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <!-- Stat tiles -->
                        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" Margin="0,0,0,8">
                            <Border Grid.Column="0" Background="#161616" BorderBrush="#262626" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,6,0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Total" FontSize="11" Foreground="#9ca3af"/>
                                    <TextBlock Text="{Binding TotalInScope}" FontSize="18" FontWeight="Bold" Foreground="#f3f4f6"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#161616" BorderBrush="#262626" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="4,0,4,0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Showing" FontSize="11" Foreground="#9ca3af"/>
                                    <TextBlock Text="{Binding MatchingCount}" FontSize="18" FontWeight="Bold" Foreground="#f3f4f6"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#161616" BorderBrush="#262626" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="6,0,0,0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Scope" FontSize="11" Foreground="#9ca3af"/>
                                    <TextBlock Text="{Binding ScopeDisplay}" FontSize="12" Foreground="#f3f4f6" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Grid.Row="2" Background="#161616" Padding="16,10" BorderBrush="#2a2a2a" BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <!-- Type Filter Chips -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="Type:" FontSize="12" Foreground="#6b7280" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <Button Content="All" Padding="10,5" FontSize="11"
                                            Command="{Binding SelectTypeCommand}" CommandParameter="All"
                                            Background="{Binding SelectedType, Converter={x:Static conv:ScopeButtonConverter.Instance}, ConverterParameter=All}"
                                            Classes="chip" Foreground="#d1d5db" BorderThickness="0"/>
                                    <Button Content="Fact" Padding="10,5" FontSize="11"
                                            Command="{Binding SelectTypeCommand}" CommandParameter="Fact"
                                            Background="{Binding SelectedType, Converter={x:Static conv:ScopeButtonConverter.Instance}, ConverterParameter=Fact}"
                                            Classes="chip" Foreground="#d1d5db" BorderThickness="0"/>
                                    <Button Content="Preference" Padding="10,5" FontSize="11"
                                            Command="{Binding SelectTypeCommand}" CommandParameter="Preference"
                                            Background="{Binding SelectedType, Converter={x:Static conv:ScopeButtonConverter.Instance}, ConverterParameter=Preference}"
                                            Classes="chip" Foreground="#d1d5db" BorderThickness="0"/>
                                    <Button Content="Decision" Padding="10,5" FontSize="11"
                                            Command="{Binding SelectTypeCommand}" CommandParameter="Decision"
                                            Background="{Binding SelectedType, Converter={x:Static conv:ScopeButtonConverter.Instance}, ConverterParameter=Decision}"
                                            Classes="chip" Foreground="#d1d5db" BorderThickness="0"/>
                                    <Button Content="Lesson" Padding="10,5" FontSize="11"
                                            Command="{Binding SelectTypeCommand}" CommandParameter="Lesson"
                                            Background="{Binding SelectedType, Converter={x:Static conv:ScopeButtonConverter.Instance}, ConverterParameter=Lesson}"
                                            Classes="chip" Foreground="#d1d5db" BorderThickness="0"/>
                                    <Button Content="Note" Padding="10,5" FontSize="11"
                                            Command="{Binding SelectTypeCommand}" CommandParameter="Note"
                                            Background="{Binding SelectedType, Converter={x:Static conv:ScopeButtonConverter.Instance}, ConverterParameter=Note}"
                                            Classes="chip" Foreground="#d1d5db" BorderThickness="0"/>
                                </StackPanel>

                                <!-- Tier + Global: same chip look, on the same strip as Type -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                            VerticalAlignment="Center" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                                IsVisible="{Binding TierApplies}">
                                        <TextBlock Text="Tier:" FontSize="12" Foreground="#6b7280" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <Button Content="All" Padding="10,5" FontSize="11"
                                                Command="{Binding TierCommand}" CommandParameter="all"
                                                Background="{Binding Tier, Converter={x:Static conv:ScopeButtonConverter.Instance}, ConverterParameter=all}"
                                                Classes="chip" Foreground="#d1d5db" BorderThickness="0"/>
                                        <Button Content="Shared" Padding="10,5" FontSize="11"
                                                Command="{Binding TierCommand}" CommandParameter="project"
                                                Background="{Binding Tier, Converter={x:Static conv:ScopeButtonConverter.Instance}, ConverterParameter=project}"
                                                Classes="chip" Foreground="#d1d5db" BorderThickness="0"/>
                                        <Button Content="Local" Padding="10,5" FontSize="11"
                                                Command="{Binding TierCommand}" CommandParameter="project-local"
                                                Background="{Binding Tier, Converter={x:Static conv:ScopeButtonConverter.Instance}, ConverterParameter=project-local}"
                                                Classes="chip" Foreground="#d1d5db" BorderThickness="0"/>
                                    </StackPanel>
                                    <Button Content="{Binding GlobalToggleText}" Padding="10,5" FontSize="11" Margin="12,0,0,0"
                                            Command="{Binding ToggleGlobalCommand}"
                                            Background="{Binding GlobalIncluded, Converter={x:Static conv:ScopeButtonConverter.Instance}, ConverterParameter=True}"
                                            Classes="chip" Foreground="#d1d5db" BorderThickness="0"/>
                                </StackPanel>

                                <!-- Search Box with Clear Button -->
                                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Grid ColumnDefinitions="*,Auto" Width="280">
                                        <TextBox Text="{Binding SearchQuery}" PlaceholderText="Search content or ID..."
                                                 Padding="10,6,28,6"/>
                                        <Button Grid.Column="1" Content="✕"
                                                Command="{Binding ClearSearchCommand}"
                                                Classes="subtle"
                                                IsVisible="{Binding SearchQuery, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                FontSize="11" Margin="0,0,4,0"
                                                VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Grid.Row="4" Background="#331818" BorderBrush="#ef4444" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8"
                                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="#ef4444" TextWrapping="Wrap"/>
                        </Border>
                        <TextBlock Grid.Row="5" Text="No memories found." FontSize="13" Foreground="#6b7280"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsEmpty}"/>
                        <ListBox Grid.Row="5"
                                 ItemsSource="{Binding FilteredMemories}"
                                 Padding="6"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="m:MemoryDto">
                                    <Border Classes="memory-card">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">

                                            <!-- Badges -->
                                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                                <Border Classes="badge"
                                                        Background="{Binding Type, Converter={x:Static conv:MemoryTypeColorConverter.Instance}}">
                                                    <TextBlock Text="{Binding Type}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                                </Border>
                                                <Border Classes="scope-badge">
                                                    <TextBlock Text="{Binding ScopeDisplay}" FontSize="10" Foreground="#9ca3af"/>
                                                </Border>
                                                <!-- Tier badge: dashboard marks a project memory as Local or Shared -->
                                                <Border Classes="scope-badge" Background="#2a1f3d"
                                                        IsVisible="{Binding IsLocalScope}">
                                                    <TextBlock Text="💻 Local" FontSize="10" Foreground="#a78bfa"/>
                                                </Border>
                                                <Border Classes="scope-badge" Background="#142e1f"
                                                        IsVisible="{Binding IsSharedProjectScope}">
                                                    <TextBlock Text="👥 Shared" FontSize="10" Foreground="#4ade80"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Action Buttons -->
                                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                <Button Content="↑ Promote" FontSize="11" Padding="8,4" CornerRadius="4"
                                                        Background="#142e1f" Foreground="#4ade80" BorderBrush="#1f4a30" BorderThickness="1"
                                                        IsVisible="{Binding IsProjectScope}"
                                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).PromptPromoteCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Promote memory to Global scope"/>
                                                <Button Content="↓ Project" FontSize="11" Padding="8,4" CornerRadius="4"
                                                        Background="#14263b" Foreground="#60a5fa" BorderBrush="#1e3a5f" BorderThickness="1"
                                                        IsVisible="{Binding IsGlobalScope}"
                                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).PromptCopyCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Copy or move memory to a Project"/>
                                                <Button Content="📁 Shared" FontSize="11" Padding="8,4" CornerRadius="4"
                                                        Background="#14263b" Foreground="#60a5fa" BorderBrush="#1e3a5f" BorderThickness="1"
                                                        IsVisible="{Binding IsLocalScope}"
                                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).MoveTierCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Move to Shared (committed with the repo)"/>
                                                <Button Content="💻 Local" FontSize="11" Padding="8,4" CornerRadius="4"
                                                        Background="#2a1f3d" Foreground="#a78bfa" BorderBrush="#3d2b5a" BorderThickness="1"
                                                        IsVisible="{Binding IsProjectScope}"
                                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).MoveTierCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Move to Local (machine-only, leaves shared)"/>
                                                <Button Content="✏ Edit" FontSize="11" Padding="8,4" CornerRadius="4"
                                                        Background="#262626" Foreground="#9ca3af" BorderThickness="0"
                                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).StartEditCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="🗑 Delete" FontSize="11" Padding="8,4" CornerRadius="4"
                                                        Background="#331818" Foreground="#ef4444" BorderThickness="0"
                                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).PromptDeleteCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>

                                            <!-- Content -->
                                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                       Text="{Binding Content}" FontSize="13" Foreground="#e5e7eb"
                                                       TextWrapping="Wrap" MaxLines="4" Margin="0,4,0,0"/>

                                            <!-- Tags -->
                                            <ItemsControl Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                          ItemsSource="{Binding Tags}" Margin="0,3,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Classes="tag">
                                                            <TextBlock Text="{Binding StringFormat='#{0}'}" FontSize="10" Foreground="#d1d5db"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- ID + Timestamps -->
                                            <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding Id, StringFormat='ID: {0}'}" FontSize="10"
                                                           Foreground="#6b7280" FontFamily="Cascadia Code,Consolas,Menlo"/>
                                                <TextBlock Text="{Binding CreatedAt, StringFormat='Created: {0:yyyy-MM-dd HH:mm}'}"
                                                           FontSize="10" Foreground="#6b7280"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,2,0,0"
                                                       Text="{Binding UpdatedAt, StringFormat='Updated: {0:yyyy-MM-dd HH:mm}'}"
                                                       FontSize="10" Foreground="#6b7280"/>

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    </Grid>
                    <views:SettingsView x:Name="SettingsPanel" IsVisible="False" DataContext="{x:Null}" />
                </Grid>
            </Grid>

            <!-- Right rail: floating island panel, matches left sidebar style -->
            <Border Grid.Row="1" Grid.Column="1" Background="#141416" BorderBrush="#252528" BorderThickness="1" CornerRadius="6" Padding="4,12,4,12" Margin="0,6,6,6">
                <StackPanel Spacing="6">
                    <Button Click="SidebarChat_Click" MinHeight="76" HorizontalAlignment="Stretch" Background="#262626" BorderThickness="0" CornerRadius="8" Padding="4">
                        <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="💬" FontSize="22" HorizontalAlignment="Center"/>
                            <TextBlock Text="Chat" FontSize="11" HorizontalAlignment="Center" Foreground="#e5e7eb"/>
                        </StackPanel>
                    </Button>
                    <Button Click="SidebarWorkspaces_Click" MinHeight="76" HorizontalAlignment="Stretch" Background="#262626" BorderThickness="0" CornerRadius="8" Padding="4">
                        <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📁" FontSize="22" HorizontalAlignment="Center"/>
                            <TextBlock Text="Workspaces" FontSize="11" HorizontalAlignment="Center" Foreground="#e5e7eb"/>
                        </StackPanel>
                    </Button>
                    <Button Click="SidebarMemory_Click" MinHeight="76" HorizontalAlignment="Stretch" Background="#262626" BorderThickness="0" CornerRadius="8" Padding="4">
                        <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🧠" FontSize="22" HorizontalAlignment="Center"/>
                            <TextBlock Text="Memory" FontSize="11" HorizontalAlignment="Center" Foreground="#e5e7eb"/>
                        </StackPanel>
                    </Button>
                    <Button Click="SidebarSettings_Click" MinHeight="76" HorizontalAlignment="Stretch" Background="#262626" BorderThickness="0" CornerRadius="8" Padding="4">
                        <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="⚙" FontSize="22" HorizontalAlignment="Center"/>
                            <TextBlock Text="Settings" FontSize="11" HorizontalAlignment="Center" Foreground="#e5e7eb"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Bottom Status Bar -->
            <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#161616" Padding="16,8" BorderBrush="#2a2a2a" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="{Binding SseStatus, Converter={x:Static conv:SseStatusColorConverter.Instance}}"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionDetails}" FontSize="11" Foreground="#9ca3af" VerticalAlignment="Center"/>
                        <TextBlock Text="|" FontSize="11" Foreground="#4b5563" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#6b7280" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding MemoryCountStatus}" FontSize="11" Foreground="#9ca3af" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>

        <!-- Create Memory Modal -->
        <Border Classes="modal-overlay" IsVisible="{Binding ShowCreateDialog}">
            <Border Classes="modal">
                <StackPanel Spacing="12">
                    <TextBlock Text="Create New Memory" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="Content" FontSize="12" Foreground="#9ca3af"/>
                    <TextBox Text="{Binding CreateContent}" AcceptsReturn="True" Height="220" MinHeight="220" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                            <TextBlock Text="Type" FontSize="12" Foreground="#9ca3af"/>
                            <ComboBox ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding CreateType}"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                            <TextBlock Text="Scope" FontSize="12" Foreground="#9ca3af"/>
                            <ComboBox ItemsSource="{Binding ScopeOptions}" SelectedItem="{Binding CreateScope, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <ComboBoxItem Content="{Binding .}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Tags (comma-separated)" FontSize="12" Foreground="#9ca3af"/>
                    <TextBox Text="{Binding CreateTags}" PlaceholderText="e.g. backend, auth, convention"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                        <Button Content="Cancel" Command="{Binding CancelCreateCommand}" Classes="subtle" Foreground="#9ca3af"/>
                        <Button Content="Save Memory" Command="{Binding SaveCreateCommand}"
                                Classes="primary" Padding="14,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Edit Memory Modal -->
        <Border Classes="modal-overlay" IsVisible="{Binding EditingMemory, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Border Classes="modal">
                <StackPanel Spacing="12">
                    <TextBlock Text="Edit Memory" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="Content" FontSize="12" Foreground="#9ca3af"/>
                    <TextBox Text="{Binding EditContent}" AcceptsReturn="True" Height="220" MinHeight="220" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                            <TextBlock Text="Type" FontSize="12" Foreground="#9ca3af"/>
                            <ComboBox ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding EditType}"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                            <TextBlock Text="Status" FontSize="12" Foreground="#9ca3af"/>
                            <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding EditStatus}"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Tags (comma-separated)" FontSize="12" Foreground="#9ca3af"/>
                    <TextBox Text="{Binding EditTags}" PlaceholderText="e.g. backend, auth"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                        <Button Content="Cancel" Command="{Binding CancelEditCommand}" Classes="subtle" Foreground="#9ca3af"/>
                        <Button Content="Save Changes" Command="{Binding SaveEditCommand}"
                                Classes="primary" Padding="14,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Delete Confirmation Modal -->
        <Border Classes="modal-overlay" IsVisible="{Binding DeleteTarget, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Border Classes="modal danger" Width="480">
                <StackPanel Spacing="12">
                    <TextBlock Text="Delete Memory?" FontSize="16" FontWeight="Bold" Foreground="#ef4444"/>
                    <TextBlock Text="This action will permanently delete this memory from storage disk. This cannot be undone."
                               FontSize="12" Foreground="#9ca3af" TextWrapping="Wrap"/>
                    <Border Background="#141414" BorderBrush="#2e2e2e" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,4,0,0">
                        <TextBlock Text="{Binding DeleteTarget.Content}" FontSize="12" MaxLines="3" TextWrapping="Wrap"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                        <Button Content="Cancel" Command="{Binding CancelDeleteCommand}" Classes="subtle" Foreground="#9ca3af"/>
                        <Button Content="Delete Permanently" Command="{Binding ConfirmDeleteCommand}"
                                Classes="danger" Padding="14,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Promote to Global Modal -->
        <Border Classes="modal-overlay" IsVisible="{Binding PromoteTarget, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Border Classes="modal" Width="520">
                <StackPanel Spacing="12">
                    <TextBlock Text="Promote to Global Scope" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="Choose promotion mode for this memory:" FontSize="12" Foreground="#9ca3af"/>
                    <Border Background="#141414" BorderBrush="#2e2e2e" BorderThickness="1" CornerRadius="6" Padding="10">
                        <TextBlock Text="{Binding PromoteTarget.Content}" FontSize="12" MaxLines="3" TextWrapping="Wrap"/>
                    </Border>
                    <RadioButton Content="Copy to Global (keep original in project)" IsChecked="{Binding !PromoteAsMove}"
                                 Foreground="#f3f4f6" FontSize="12"/>
                    <RadioButton Content="Move to Global (delete original from project)" IsChecked="{Binding PromoteAsMove}"
                                 Foreground="#f59e0b" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                        <Button Content="Cancel" Command="{Binding CancelPromoteCommand}" Classes="subtle" Foreground="#9ca3af"/>
                        <Button Content="Promote" Command="{Binding ConfirmPromoteCommand}"
                                Classes="primary" Padding="14,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Copy/Demote to Project Modal -->
        <Border Classes="modal-overlay" IsVisible="{Binding CopyTarget, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Border Classes="modal" Width="520">
                <StackPanel Spacing="12">
                    <TextBlock Text="Copy/Move to Project" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="Target Project" FontSize="12" Foreground="#9ca3af"/>
                    <ComboBox ItemsSource="{Binding Workspaces}" SelectedItem="{Binding CopyTargetWorkspace}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="m:WorkspaceItem">
                                <TextBlock Text="{Binding Name, StringFormat='📁 {0}'}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Border Background="#141414" BorderBrush="#2e2e2e" BorderThickness="1" CornerRadius="6" Padding="10">
                        <TextBlock Text="{Binding CopyTarget.Content}" FontSize="12" MaxLines="3" TextWrapping="Wrap"/>
                    </Border>
                    <RadioButton Content="Copy to Project (keep in global)" IsChecked="{Binding !CopyAsMove}"
                                 Foreground="#f3f4f6" FontSize="12"/>
                    <RadioButton Content="Move to Project (delete from global)" IsChecked="{Binding CopyAsMove}"
                                 Foreground="#f59e0b" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                        <Button Content="Cancel" Command="{Binding CancelCopyCommand}" Classes="subtle" Foreground="#9ca3af"/>
                        <Button Content="Confirm" Command="{Binding ConfirmCopyCommand}"
                                Classes="primary" Padding="14,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

    </Grid>

</Window>
