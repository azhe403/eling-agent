#!/bin/sh
# Path-aware & anti-locked pre-push: test the layer touched plus every layer
# it depends on (same model as pre-commit: core / backend=+core /
# desktop=+backend+core / dashboard=frontend only).
# - isolated build/test via ELING_OUTPUT_ROOT=.bin-hook-<pid> (disposable
#   per-run root) avoids .bin lock collisions with the dev server,
#   manual runs, MCP hosts, and concurrent hooks
# - after the checks pass, publish a Release build into ~/.local/bin
# Bypass: SKIP_HOOK=1 git push --no-verify  or  FULL_CHECK=1 git push

if [ "$SKIP_HOOK" = "1" ]; then
  echo "→ SKIP_HOOK=1: skipping pre-push checks"
  exit 0
fi

# Anti-lock: every dotnet invocation below builds/tests under a disposable
# per-run root (.bin-hook-<pid>), so it can never collide with the dev
# server (.bin), manual runs (.bin-test), MCP hosts, or another hook
# running concurrently. NOTE: plain `export ELING_OUTPUT_ROOT` does not
# work here — package.json scripts hardcode it via cross-env — so the
# dotnet calls below set it inline (same precedent as scripts/ci-check.sh).
# Already gitignored (.bin*) and auto-cleaned by scripts/clean-bin.ps1.
HOOK_ROOT=".bin-hook-$$"
trap 'rm -rf "$HOOK_ROOT"' EXIT INT TERM

# Same retry posture as pre-commit: the Core suite's failure mode is
# intermittent (parallel races, mid-edit compile windows), so one flake
# should not block a push; a real failure still fails all three attempts.
# Runs under $HOOK_ROOT (see above) so retries never meet a locked output.
# Defined before FULL_CHECK because that block calls it.
run_core_tests() {
  attempt=1
  while [ "$attempt" -le 3 ]; do
    echo "→ core tests (attempt $attempt/3)"
    if ELING_OUTPUT_ROOT="$HOOK_ROOT" dotnet test tests/Eling.Core.Tests/Eling.Core.Tests.csproj; then
      return 0
    fi
    attempt=$((attempt + 1))
    if [ "$attempt" -le 3 ]; then sleep 3; fi
  done
  return 1
}

CHANGED=$(git diff --name-only "@{u}..HEAD" 2>/dev/null || git diff --name-only "origin/main...HEAD" 2>/dev/null || git diff --name-only HEAD~1 2>/dev/null)

# Publishes a Release build and installs it into ~/.local/bin. This is not a
# remote-side action: it overwrites the installed binary and stops any process
# holding it, so pushing code nobody can run is exactly the case this catches.
# Dispatch on the real OS -- each script hardcodes the other platform's default
# and would fail rather than half-install.
run_publish() {
  case "$(uname -s 2>/dev/null || echo unknown)" in
    MINGW*|MSYS*|CYGWIN*) SCRIPT="scripts/publish-global.ps1" ;;
    *)                    SCRIPT="scripts/publish-global.sh" ;;

  esac

  if [ ! -f "$SCRIPT" ]; then
    echo "→ publish script not found: $SCRIPT"
    return 1
  fi

  echo "→ publishing + installing (~/.local/bin) via $SCRIPT"
  case "$SCRIPT" in
    *.ps1) pwsh -NoProfile -File "$SCRIPT" || return 1 ;;
    *)     sh "$SCRIPT" || return 1 ;;
  esac
}

if [ "$FULL_CHECK" = "1" ]; then
  echo "→ FULL_CHECK=1: running full build and tests (isolated output $HOOK_ROOT)"
  ELING_OUTPUT_ROOT="$HOOK_ROOT" dotnet build Eling.slnx || exit 1
  run_core_tests || exit 1
  echo "→ api layer: test:backend:api"
  ELING_OUTPUT_ROOT="$HOOK_ROOT" dotnet test tests/Eling.Backend.Tests/Eling.Backend.Tests.csproj --filter FullyQualifiedName!~DashboardLifecycleTests || exit 1
  echo "→ desktop layer: test:backend:desktop"
  ELING_OUTPUT_ROOT="$HOOK_ROOT" dotnet test tests/Eling.Desktop.Tests/Eling.Desktop.Tests.csproj || exit 1
  pnpm build:frontend || exit 1
  run_publish || exit 1
  exit 0
fi

NEED_FRONTEND=0
NEED_CORE=0
NEED_API=0
NEED_DESKTOP=0

if echo "$CHANGED" | grep -q "^src/frontend/"; then
  NEED_FRONTEND=1
fi

# Core layer: core tests only.
if echo "$CHANGED" | grep -qE "^(src/backend/Eling\.Core/|tests/Eling\.Core\.Tests/)"; then
  NEED_CORE=1
fi

# Backend layer: pulls core in (backend depends on core).
if echo "$CHANGED" | grep -qE "^(src/backend/Eling\.Backend/|tests/Eling\.Backend\.Tests/)"; then
  NEED_CORE=1
  NEED_API=1
fi

# Desktop layer: pulls backend + core in (desktop depends on both).
if echo "$CHANGED" | grep -qE "^(src/desktop/|tests/Eling\.Desktop\.Tests/)"; then
  NEED_CORE=1
  NEED_API=1
  NEED_DESKTOP=1
fi

# Any other backend project (future one, not Eling.Core): assume api layer.
if echo "$CHANGED" | grep -qE "^src/backend/" && [ "$NEED_CORE" = "0" ]; then
  NEED_CORE=1
  NEED_API=1
fi

# Unknown tests/ change (e.g. a new test project): run all C# layers.
if echo "$CHANGED" | grep -qE "^tests/" && [ "$NEED_CORE" = "0" ] && [ "$NEED_API" = "0" ] && [ "$NEED_DESKTOP" = "0" ]; then
  NEED_CORE=1
  NEED_API=1
  NEED_DESKTOP=1
fi

# Solution/build files affect every C# layer.
if echo "$CHANGED" | grep -qE "^(Directory\.Build|Eling\.slnx|mise\.toml)"; then
  NEED_CORE=1
  NEED_API=1
  NEED_DESKTOP=1
fi

# package manifest affects both worlds.
if echo "$CHANGED" | grep -qE "^(package\.json|pnpm-lock\.yaml)"; then
  NEED_FRONTEND=1
  NEED_CORE=1
  NEED_API=1
  NEED_DESKTOP=1
fi

if [ "$NEED_FRONTEND" = "0" ] && [ "$NEED_CORE" = "0" ] && [ "$NEED_API" = "0" ] && [ "$NEED_DESKTOP" = "0" ]; then
  echo "→ pre-push: docs/config only, nothing to check"
  exit 0
fi

if [ "$NEED_CORE" = "1" ]; then
  run_core_tests || exit 1
fi

if [ "$NEED_API" = "1" ]; then
  echo "→ api layer: building backend + test:backend:api (isolated output $HOOK_ROOT)"
  ELING_OUTPUT_ROOT="$HOOK_ROOT" dotnet build Eling.slnx || exit 1
  ELING_OUTPUT_ROOT="$HOOK_ROOT" dotnet test tests/Eling.Backend.Tests/Eling.Backend.Tests.csproj --filter FullyQualifiedName!~DashboardLifecycleTests || exit 1
fi

if [ "$NEED_DESKTOP" = "1" ]; then
  echo "→ desktop layer: test:backend:desktop (isolated output $HOOK_ROOT)"
  ELING_OUTPUT_ROOT="$HOOK_ROOT" dotnet test tests/Eling.Desktop.Tests/Eling.Desktop.Tests.csproj || exit 1
fi

if [ "$NEED_FRONTEND" = "1" ]; then
  echo "→ frontend changed: building dashboard"
  pnpm build:frontend || exit 1
fi

run_publish || exit 1
