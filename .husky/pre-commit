#!/bin/sh
# Path-aware pre-commit: only run checks relevant to staged changes.
# - docs-only (no src/frontend|backend|tests) → skip all, instant
# - backend/docs commits skip frontend lint/typecheck (save 25-70s)
# - frontend lint + typecheck run in parallel (save 10-20s)
# - validate:backend redundant (test:backend already restores) → only on FULL_CHECK=1
# Bypass: SKIP_HOOK=1 git commit --no-verify  or  FULL_CHECK=1 git commit

if [ "$SKIP_HOOK" = "1" ]; then
  echo "→ SKIP_HOOK=1: skipping pre-commit"
  exit 0
fi

CHANGED=$(git diff --cached --name-only 2>/dev/null)

if [ "$FULL_CHECK" = "1" ]; then
  echo "→ FULL_CHECK=1: running all checks"
  pnpm lint:frontend || exit 1
  pnpm typecheck:frontend || exit 1
  pnpm validate:backend || exit 1
  pnpm test:backend || exit 1
  exit 0
fi

NEED_FRONTEND=0
NEED_BACKEND=0
NEED_DESKTOP=0

if echo "$CHANGED" | grep -q "^src/frontend/"; then
  NEED_FRONTEND=1
fi

if echo "$CHANGED" | grep -qE "^src/backend/"; then
  NEED_BACKEND=1
fi

if echo "$CHANGED" | grep -qE "^src/desktop/"; then
  NEED_DESKTOP=1
fi

if echo "$CHANGED" | grep -qE "^tests/Eling\.(Core|Backend)\.Tests/"; then
  NEED_BACKEND=1
fi

if echo "$CHANGED" | grep -qE "^tests/Eling\.Desktop\.Tests/"; then
  NEED_DESKTOP=1
fi

# Fallback for any other tests/ changes (e.g. new test project): run both
if echo "$CHANGED" | grep -qE "^tests/" && [ "$NEED_BACKEND" = "0" ] && [ "$NEED_DESKTOP" = "0" ]; then
  NEED_BACKEND=1
  NEED_DESKTOP=1
fi

if echo "$CHANGED" | grep -qE "^(Directory\.Build|Eling\.slnx|package\.json|pnpm-lock\.yaml|mise\.toml)"; then
  NEED_BACKEND=1
  NEED_DESKTOP=1
fi

if [ "$NEED_FRONTEND" = "0" ] && [ "$NEED_BACKEND" = "0" ] && [ "$NEED_DESKTOP" = "0" ]; then
  echo "→ pre-commit: docs/config only, skipping lint/typecheck/test"
  exit 0
fi

if [ "$NEED_FRONTEND" = "1" ]; then
  echo "→ frontend changed: lint + typecheck (parallel)"
  pnpm lint:frontend & LINT_PID=$!
  pnpm typecheck:frontend & TYPE_PID=$!
  wait $LINT_PID || exit 1
  wait $TYPE_PID || exit 1
else
  echo "→ skip frontend (no src/frontend/)"
fi

if [ "$NEED_BACKEND" = "1" ]; then
  echo "→ backend changed: test:backend:core + test:backend:api"
  pnpm run test:backend:core || exit 1
  pnpm run test:backend:api || exit 1
else
  echo "→ skip backend (no src/backend|core/api tests|build files)"
fi

if [ "$NEED_DESKTOP" = "1" ]; then
  echo "→ desktop changed: test:backend:desktop"
  pnpm run test:backend:desktop || exit 1
else
  echo "→ skip desktop (no src/desktop|desktop tests)"
fi
