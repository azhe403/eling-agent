<Project>
<PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Single source of truth for the product version. The pre-release CI
          workflow reads this base version and appends -pre.{run_number}. -->
    <Version>0.1.0</Version>
    <!-- Per-configuration .bin/ output to avoid lock conflicts between dev (Debug)
          and test/publish (Release) processes that hold the .bin/ DLLs in memory.
          obj/ stays per-project (default `obj/<Config>/<Framework>/`), which is what
          the live dev backend at port 4417 already uses. -->
    <OutputPath Condition="'$(ArtifactsPath)' == ''">$(MSBuildThisFileDirectory).bin\$(Configuration)\</OutputPath>
    <!-- eling-live MCP launches via `dotnet run`: any MSBuild output would pollute
          the stdout JSON-RPC stream. Keep restore/build output silent repo-wide. -->
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
</Project>
