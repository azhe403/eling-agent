{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "eling_dev": {
        "type": "local",
        "command": [
          "dotnet",
          "run",
          "--artifacts-path",
          ".bin-relay",
          "--file",
          "scripts/DevRelay.cs"
        ],
        "cwd": ".",
        "environment": {
          "ELING_DASHBOARD_PORT": "4417",
          "ELING_WATCH_DASHBOARD": "1",
          "ASPNETCORE_ENVIRONMENT": "Development"
        },
        "disabled": false,
        "timeout": {
          "startup": 200000
        },
        "protocol": "auto",
        "codemode": false
      },
      "eling": {
        "type": "local",
        "command": [
          "eling-backend"
        ],
        "disabled": false,
        "codemode": false
      }
    }
  }
}
