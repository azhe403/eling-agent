{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "eling_dev": {
        "type": "local",
        "command": [
          "dotnet",
          "watch",
          "--project",
          "src/backend/Eling.Backend/Eling.Backend.csproj"
        ],
        "cwd": ".",
        "environment": {
          "ELING_OUTPUT_ROOT": ".bin-opencode",
          "ELING_DASHBOARD_PORT": "4417",
          "ELING_WATCH_DASHBOARD": "1",
          "XDOTNET_WATCH_RESTART_ON_RUDE_EDIT": "1"
        },
        "disabled": false,
        "timeout": {
          "startup": 60000,
          "catalog": 30000,
          "execution": 30000
        }
      },
      "eling": {
        "type": "local",
        "command": [
          "eling-backend"
        ],
        "disabled": false
      },
      "shadcn": {
        "type": "local",
        "command": [
          "npx",
          "shadcn@latest",
          "mcp"
        ],
        "disabled": false
      }
    }
  }
}